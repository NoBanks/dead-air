# Variable names the code reads. The code does not load this file itself
# (there is no dotenv). Export these in your shell, or set them in your
# process manager. Keep your real values outside the repo.

# Station server (station/src/dev-server.ts)
# Folder with the encoded song MP3s
LIBRARY_OUT=
# Folder with Dead John's voice clip MP3s
VOICE_OUT=
# Folder where request line data is kept (default: ~/.deadair/requests)
REQUESTS_DIR=
# Path to the ffmpeg binary (used to mix the /stream)
FFMPEG=
# Port to listen on (default 8787)
PORT=
# Bind address (default ::). Use 127.0.0.1 behind a tunnel.
HOST=
# Folder of the built web client to serve, for example ../web/dist
STATIC_DIR=
# Set to 1 to keep /stream mixing with no listeners
STREAM_ALWAYS_ON=
# Process memory limit in MB (default 1500)
RSS_LIMIT_MB=
# Set to any value to log stream memory stats
STREAM_DEBUG=

# Request line studio worker (tools/studio/worker.py, also reads REQUESTS_DIR and FFMPEG)
# Path to the local voice studio script
STUDIO=
# Python interpreter that runs the voice studio
VOICE_PY=

# Library builder (tools/library)
# Source track list (CSV)
CSV_PATH=
# FFMPEG and LIBRARY_OUT above are also read by this tool
